# Outline - Minimal env vars (copy to docker.env)
# Generate secrets: openssl rand -hex 32

URL=http://localhost:3000
# DB: use either DATABASE_URL OR separate vars
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=outline
DATABASE_USER=outline
DATABASE_PASSWORD=outline_password_change_me
# or: DATABASE_URL=postgres://outline:outline_password_change_me@postgres:5432/outline
REDIS_URL=redis://redis:6379
SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32
UTILS_SECRET=REPLACE_WITH_openssl_rand_hex_32

# Auth: add ONE - Azure (AZURE_CLIENT_ID, AZURE_CLIENT_SECRET) or Google
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
