# Outline - Environment variables
# Copy to docker.env and update values before running
# Docs: https://github.com/outline/outline/blob/main/.env.sample

NODE_ENV=production
URL=http://localhost:3000
PORT=3000

# Generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32
UTILS_SECRET=REPLACE_WITH_openssl_rand_hex_32

# Database (must match postgres service in docker-compose)
DATABASE_URL=postgres://outline:outline_password_change_me@postgres:5432/outline
PGSSLMODE=disable

# Redis
REDIS_URL=redis://redis:6379

# Local file storage
FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000

# Local dev: no HTTPS
FORCE_HTTPS=false

# Auth: at least ONE required (Google, Slack, Microsoft, Discord, or SMTP for email)
# Google - https://docs.getoutline.com/s/hosting/doc/google-hOuvtCmTqQ
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP (optional, for email magic links)
# SMTP_SERVICE=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
